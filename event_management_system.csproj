<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

  <!-- Exclude the test project folder from this project's compilation -->
  <ItemGroup>
    <Compile Remove="event_management_system.Tests\**\*" />
    <Content Remove="event_management_system.Tests\**\*" />
    <None Remove="event_management_system.Tests\**\*" />
    <EmbeddedResource Remove="event_management_system.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\OneDrive\Desktop\swagger-screenshot.png" Link="docs\swagger-screenshot.png" />
  </ItemGroup>

</Project>