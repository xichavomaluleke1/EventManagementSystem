@model RaceDayMVC.Models.CategoryFormViewModel
@{
    var eventModel = ViewBag.Event as RaceDayMVC.Models.EventViewModel;
    ViewData["Title"] = $"Manage Categories - {eventModel?.EventName}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success fw-bold">Manage Categories: @eventModel?.EventName</h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Add Category Form -->
        <div class="col-md-4">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Add New Category</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post">
                        <input type="hidden" asp-for="EventId" />

                        <div class="mb-3">
                            <label asp-for="CategoryName" class="form-label fw-bold">Category Name</label>
                            <input asp-for="CategoryName" class="form-control" placeholder="e.g. Senior Men, 10km" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <input asp-for="Description" class="form-control" placeholder="Optional" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinAge" class="form-label fw-bold">Min Age</label>
                                <input asp-for="MinAge" class="form-control" type="number" placeholder="e.g. 18" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxAge" class="form-label fw-bold">Max Age</label>
                                <input asp-for="MaxAge" class="form-control" type="number" placeholder="e.g. 39" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EntryFee" class="form-label fw-bold">Entry Fee (R)</label>
                            <input asp-for="EntryFee" class="form-control" type="number" step="0.01" placeholder="e.g. 150" />
                        </div>
                        <button type="submit" class="btn btn-success w-100">Add Category</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Existing Categories List -->
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Existing Categories</h5>
                </div>
                <div class="card-body p-0">
                    @if (eventModel?.Categories == null || !eventModel.Categories.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <p>No categories added yet. Use the form on the left to add one.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Age Range</th>
                                    <th>Fee</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in eventModel.Categories)
                                {
                                    <tr>
                                        <td class="fw-bold">@cat.CategoryName</td>
                                        <td>@(cat.MinAge.HasValue ? $"{cat.MinAge} - {cat.MaxAge}" : "Open")</td>
                                        <td>R @cat.EntryFee</td>
                                        <td class="text-end">
                                            <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Are you sure you want to delete this category?');" class="d-inline">
                                                <input type="hidden" name="categoryId" value="@cat.CategoryID" />
                                                <input type="hidden" name="eventId" value="@eventModel.EventID" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>