@model RaceDayMVC.Models.CreateEventViewModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <h2 class="text-success fw-bold">Create a New Event</h2>
    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label fw-bold">Event Name</label>
                            <input asp-for="EventName" class="form-control" required />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EventDate" class="form-label fw-bold">Date</label>
                                <input asp-for="EventDate" class="form-control" type="date" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Location" class="form-label fw-bold">Location</label>
                                <input asp-for="Location" class="form-control" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Distance" class="form-label fw-bold">Distance (km)</label>
                                <input asp-for="Distance" class="form-control" type="number" step="0.1" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                                <select asp-for="EventType" class="form-select">
                                    <option value="Run">Run</option>
                                    <option value="Walk">Walk</option>
                                    <option value="Cycle">Cycle</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="EntryFee" class="form-label fw-bold">Entry Fee (R)</label>
                                <input asp-for="EntryFee" class="form-control" type="number" step="0.01" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BannerImage" class="form-label fw-bold">Event Banner Image</label>
                            <input asp-for="BannerImage" class="form-control" type="file" accept="image/*" />
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100">Create Event</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}