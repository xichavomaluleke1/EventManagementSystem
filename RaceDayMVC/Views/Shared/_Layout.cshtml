<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDayMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light">
            <div class="container">
                <!-- 🆕 Simplified Logo matching screenshot #2 -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="RaceDay Logo" />
                    RaceDay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (Context.Session.GetString("Role") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                            </li>
                        }
                        else if (Context.Session.GetString("Role") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (Context.Session.GetInt32("UserID") != null)
                        {
                            var profilePic = Context.Session.GetString("ProfilePictureURL");
                            if (string.IsNullOrEmpty(profilePic)) { profilePic = Url.Content("~/images/default-avatar.png"); }
                            <li class="nav-item">
                                <a asp-controller="Profile" asp-action="Index" title="My Profile">
                                    <img src="@profilePic" class="rounded-circle shadow-sm" style="width: 40px; height: 40px; object-fit: cover; border: 2px solid #e9ecef;" alt="Profile" />
                                </a>
                            </li>
                            <li class="nav-item ms-3">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-danger text-decoration-none p-0">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success ms-3" asp-controller="Auth" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- RenderBody must be inside .container for your CSS flex rules to work -->
    <div class="container">
        @RenderBody()
    </div>

    <!-- Footer sits outside the container -->
    <footer class="footer text-muted text-center">
        <div class="container" style="flex: none;">
            &copy; 2026 - RaceDay - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>