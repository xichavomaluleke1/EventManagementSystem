@model IEnumerable<RaceDayMVC.Models.MyEventViewModel>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-5">
    <h2 class="fw-bold mb-4">My Enrolled Events</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info py-4 text-center">
            <h4>You haven't enrolled in any events yet.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-success mt-3">Browse Events</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@item.EventName</h5>
                            @if (item.Status == "Confirmed" || item.Status == "Completed")
                            {
                                <span class="badge badge-confirmed">@item.Status</span>
                            }
                            else if (item.Status == "Pending")
                            {
                                <span class="badge badge-pending">@item.Status</span>
                            }
                            else
                            {
                                <span class="badge badge-cancelled">@item.Status</span>
                            }
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li class="d-flex align-items-center mb-3">
                                    <div class="icon-circle">
                                        <img src="~/images/icon-calendar.png" alt="Date" />
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Date</small>
                                        <span class="fw-bold">@item.EventDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                </li>
                                <li class="d-flex align-items-center mb-3">
                                    <div class="icon-circle">
                                        <img src="~/images/icon-location.png" alt="Location" />
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Location</small>
                                        <span class="fw-bold">@item.Location</span>
                                    </div>
                                </li>
                                <li class="d-flex align-items-center mb-3">
                                    <div class="icon-circle">
                                        <img src="~/images/icon-route.png" alt="Type" />
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Distance & Type</small>
                                        <span class="fw-bold">@item.EventType (@item.Distance km)</span>
                                    </div>
                                </li>
                                <li class="d-flex align-items-center">
                                    <div class="icon-circle">
                                        <img src="~/images/icon-payment.png" alt="Payment" />
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Payment</small>
                                        <span class="fw-bold">@item.PaymentStatus</span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>